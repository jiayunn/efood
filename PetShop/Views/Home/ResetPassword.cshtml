
@{
    ViewBag.Title = "重設密碼";
}

<style>
    /* 外層容器：讓卡片置中 */
    .container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 90vh;
    }

    /* 卡片樣式 */
    .card {
        background: #fff;
        padding: 2rem;
        border-radius: 12px;
        box-shadow: 0 6px 20px rgba(0,0,0,0.1);
        width: 350px;
        min-height: 400px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    /* 錯誤訊息 */
    .alert-danger {
        background: #ffe6e6;
        color: #d8000c;
        padding: 8px;
        border-radius: 6px;
        font-size: 14px;
        margin-bottom: 15px;
        text-align: center;
    }

    /* 表單輸入框 */
    .form-control {
        width: 95%;
        padding: 10px;
        margin-bottom: 12px;
        border-radius: 8px;
        border: 1px solid #ccc;
        transition: border 0.2s, box-shadow 0.2s;
    }

        .form-control:focus {
            border: 1px solid #4a90e2;
            box-shadow: 0 0 6px rgba(74,144,226,0.5);
            outline: none;
        }
</style>

<div class="container">
    <div class="card">
        <h2 style="text-align: center; color: #537db7;">重設密碼</h2>

        @if (TempData["Note"] != null)
        {
            <div class="alert-danger">@TempData["Note"]</div>
        }

        <form method="post" action="@Url.Action("ResetPassword","Home")">
            <div class="form-group">
                <label>帳號（Email）</label>
                <input type="email" name="account" class="form-control" required value="@(ViewBag.Account ?? "")" />
            </div>
            <div class="form-group">
                <label>驗證碼</label>
                <input type="text" name="code" class="form-control" required maxlength="6" />
            </div>
            <div class="form-group">
                <label>新密碼</label>
                <input type="password" name="newPassword" class="form-control" required />
            </div>
            <div class="form-group">
                <label>確認新密碼</label>
                <input type="password" name="confirmPassword" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-primary">重設密碼</button>
        </form>
    </div>
</div>

<script>
    // 若帳號有預設值，將焦點移到驗證碼欄
    (function(){
        var account = '@(ViewBag.Account ?? "")';
        if (account && document.getElementById('codeInput')) {
            document.getElementById('codeInput').focus();
        }
    })();
</script>